# Copy this file to .env and fill in your values
NODE_ENV=development
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/djgh
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/djgh
MONGODB_URI=mongodb://127.0.0.1:27017/djgh

# JWT secret — use a long random string in production
JWT_SECRET=replace_with_a_secure_random_string_at_least_64_chars

# Admin credentials (used during seeding, change before deployment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_unique_password

# Allowed frontend origin for CORS
CLIENT_ORIGIN=http://localhost:5173
