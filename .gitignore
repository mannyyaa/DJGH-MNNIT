# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Environment variables — NEVER commit secrets ──────────────────────────────
# Ignore all .env files at any depth
.env
**/.env

# Ignore all environment-specific variants (e.g. .env.local, .env.production, .env.development)
.env.*
**/.env.*

# Explicitly allow .env.example files — these are safe to commit
!.env.example
!**/.env.example

# ── Build output ──────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
logs/

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Uploads (user-uploaded files, if any) ────────────────────────────────────
server/uploads/

# ── Editor ───────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?
